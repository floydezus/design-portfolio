---
import Resume from '../components/Resume.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEFAULT_LOCALE, getLocaleContent } from '../lib/content';

const content = await getLocaleContent(Astro.currentLocale ?? DEFAULT_LOCALE);
const { ui, profile } = content;
---

<BaseLayout content={content} title={`${ui.cv.title} – ${profile.name}`} description={ui.cv.description}>
  <Resume content={content} />
</BaseLayout>
