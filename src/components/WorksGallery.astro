---
import { Picture } from 'astro:assets';
import type { LocaleContent } from '../lib/content';
import { placementSizes, placementStyle } from '../lib/placement';

interface Props {
  content: LocaleContent;
}

const { ui, projects } = Astro.props.content;
const EAGER_COUNT = 3;
const widths = [400, 600, 800, 1000, 1200, 1600];
---

<section class="works" aria-labelledby="works-heading">
  <h2 id="works-heading" class="sr-only">{ui.works.heading}</h2>
  <ul class="placed-grid">
    {
      projects.map((project, index) => {
        const Wrapper = project.href ? 'a' : 'div';
        return (
          <li id={project.slug} class="placed" style={placementStyle(project)}>
            <Wrapper
              href={project.href}
              class:list={['work', { extra: project.kind === 'extra' }]}
              aria-labelledby={project.href && `${project.slug}-title ${project.slug}-category`}
            >
              <Picture
                src={project.cover}
                alt={project.alt}
                formats={['avif', 'webp']}
                widths={widths}
                sizes={placementSizes(project)}
                loading={index < EAGER_COUNT ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : 'auto'}
                decoding="async"
              />
              <span class="caption">
                <span id={`${project.slug}-title`} class="title">
                  {project.title}
                  {project.href && (
                    <svg class="arrow" viewBox="0 0 16 10" aria-hidden="true">
                      <path d="M0 5h14.5M10.5 1l4 4-4 4" />
                    </svg>
                  )}
                </span>
                <span id={`${project.slug}-category`} class="category">
                  {project.category}
                </span>
              </span>
            </Wrapper>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .works {
    padding: clamp(1.5rem, 3vw, 3rem) var(--gutter) clamp(1rem, 3vw, 3rem);
  }

  .work,
  .work:is(:hover, :active) {
    position: relative;
    display: block;
    color: inherit;
  }

  .caption {
    display: flex;
    flex-direction: column;
    margin-block-start: 0.6em;
    font-size: var(--fs-small);
    line-height: 1.3;
  }

  .extra .title {
    font-style: italic;
  }

  .arrow {
    display: inline-block;
    width: 0.95em;
    height: 0.6em;
    margin-inline-start: 0.3em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.1;
    vertical-align: 0.05em;
  }

  .category {
    color: var(--text-muted);
  }

  /* Touch screens keep the caption in flow; with a pointer it is revealed on hover or focus. */
  @media (hover: hover) and (pointer: fine) {
    .caption {
      position: absolute;
      inset-inline: 0;
      top: 100%;
      opacity: 0;
      translate: 0 -0.4em;
    }

    .work:is(:hover, :focus-visible) .caption {
      opacity: 1;
      translate: 0 0;
    }

    .work:is(:hover, :focus-visible) :global(img) {
      scale: 1.02;
    }

    .work:is(:hover, :focus-visible) .arrow {
      translate: 0.25em 0;
    }

    .placed-grid:has(.work:is(:hover, :focus-visible)) .work:not(:hover, :focus-visible) {
      opacity: 0.35;
    }

    @media (prefers-reduced-motion: no-preference) {
      .work,
      .caption {
        transition:
          opacity 0.4s ease,
          translate 0.4s ease;
      }

      .work :global(img) {
        transition: scale 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
      }

      .arrow {
        transition: translate 0.4s cubic-bezier(0.2, 0.7, 0.2, 1) 0.1s;
      }
    }
  }

  /* Touch screens have no hover, so the tap itself gets a press response. */
  @media (hover: none) {
    .work:active :global(img) {
      scale: 0.98;
    }

    @media (prefers-reduced-motion: no-preference) {
      .work :global(img) {
        transition: scale 0.2s ease;
      }
    }
  }
</style>
