---
import type { LocaleContent } from '../lib/content';

interface Props {
  content: LocaleContent;
}

const { ui, profile } = Astro.props.content;

const languages = profile.languages.map((language) => `${language.name} (${language.level})`).join(', ');
const skills = [languages, profile.tools.join(', '), ...profile.skills].join(' / ');
const capitalize = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);
---

<article class="resume" aria-labelledby="resume-heading">
  <h1 id="resume-heading" class="sr-only">{ui.cv.heading}</h1>
  <p class="pdf-link">
    <a href={profile.cvPdf} type="application/pdf">{ui.cv.download}</a>
  </p>

  <section aria-labelledby="education-heading">
    <h2 id="education-heading" class="section-title">{ui.cv.education}</h2>
    {
      profile.education.map((item) => (
        <div class="entry">
          <p class="lead">{item.url ? <a href={item.url}>{item.institution}</a> : item.institution}</p>
          {item.degree && <p>{item.degree}</p>}
          <p>{item.place}</p>
        </div>
      ))
    }
  </section>

  <section aria-labelledby="skills-heading">
    <h2 id="skills-heading" class="section-title">{ui.cv.skills}</h2>
    <p class="entry">{skills}</p>
  </section>

  <section aria-labelledby="experience-heading">
    <h2 id="experience-heading" class="section-title">{ui.cv.experience}</h2>
    {
      profile.experience.map((job) => (
        <article class="entry">
          <p class="when">
            <time datetime={String(job.start)}>{job.start}</time>
            {job.end === null ? (
              <> – {ui.cv.present}</>
            ) : (
              job.end !== job.start && (
                <>
                  {' – '}
                  <time datetime={String(job.end)}>{job.end}</time>
                </>
              )
            )}
          </p>
          <h3 class="lead">
            {job.url ? <a href={job.url}>{job.company}</a> : job.company} | {job.role}
          </h3>
          <p>{job.location ? `${job.location} (${job.format})` : capitalize(job.format)}</p>
          <ul>
            {job.duties.map((duty) => (
              <li>· {duty}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </section>

  <section aria-labelledby="approach-heading">
    <h2 id="approach-heading" class="section-title">{ui.cv.approach}</h2>
    <ul class="entry">
      {
        profile.approach.map((item) => (
          <li>
            <span class="lead">{item.title}.</span> {item.text}
          </li>
        ))
      }
    </ul>
  </section>
</article>

<style>
  .resume {
    --fs-entry: clamp(1.125rem, 2.05vw, 1.875rem);

    display: grid;
    gap: clamp(2.5rem, 4.5vw, 4rem);
    max-width: 44em;
    padding: clamp(1.5rem, 3vw, 3rem) var(--gutter) 0;
    font-size: var(--fs-entry);
    line-height: 1.3;
  }

  .pdf-link {
    font-size: var(--fs-index);
    line-height: 1.1;
  }

  .section-title {
    margin-block-end: 0.6em;
    font-size: var(--fs-display);
    font-weight: 600;
    line-height: 1.1;
  }

  .entry + .entry {
    margin-block-start: 1.3em;
  }

  .when {
    font-style: italic;
    font-weight: 600;
    font-variant-numeric: lining-nums;
  }

  .lead {
    font-weight: 600;
  }

  .entry a {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.15em;
  }
</style>
